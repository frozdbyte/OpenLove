{
  "name": "openlove",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "dev:push": "node scripts/dev-push-cli.js",
    "build": "prisma generate && vite build && node scripts/verify-precache.js",
    "verify:precache": "node scripts/verify-precache.js",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "image:build": "node scripts/build-image.js",
    "image:publish": "node scripts/publish-image.js",
    "image:release": "node scripts/release.js",
    "podman:build": "node scripts/build-image.js",
    "podman:publish": "node scripts/publish-image.js",
    "podman:release": "node scripts/release.js"
  },
  "dependencies": {
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@lucide/svelte": "^1.34.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/vite": "^4.0.9",
    "better-sqlite3": "^13.0.3",
    "bits-ui": "^1.3.6",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "idb-keyval": "^6.2.1",
    "jsqr": "^1.4.0",
    "lucide-svelte": "^0.475.0",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.9",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.17.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.5",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/sveltekit": "^0.6.2",
    "prisma": "^7.9.1",
    "svelte": "^5.20.5",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.11",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "better-sqlite3",
      "esbuild",
      "prisma"
    ]
  }
}
