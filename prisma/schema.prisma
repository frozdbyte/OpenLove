datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

model PushSubscription {
  id            String   @id @default(uuid())
  endpoint      String   @unique
  p256dh        String
  auth          String
  togetherSince String   // YYYY-MM-DD
  timezone      String   @default("UTC")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastNotified  String?  // e.g. "2026-08-25:100_days" to prevent duplicate notifications
  // ISO-8601 on the *client* clock. Every write is applied only when
  // op.clientUpdatedAt >= row.clientUpdatedAt, so a mutation queued offline on a phone
  // three days ago cannot clobber a newer change made on a laptop yesterday.
  // String comparison is lexicographic for ISO-8601, so no parsing is needed.
  // Not personal data - a timestamp only. See AGENTS.md Invariant 1.
  clientUpdatedAt String @default("1970-01-01T00:00:00.000Z")
}
