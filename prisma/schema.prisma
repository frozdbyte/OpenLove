datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

model PushSubscription {
  id              String             @id @default(uuid())
  endpoint        String             @unique
  p256dh          String
  auth            String
  timezone        String             @default("UTC")
  togetherSince   String?            // Optional legacy field for backward compatibility
  lastNotified    String?            // Optional legacy field
  clientUpdatedAt String             @default("1970-01-01T00:00:00.000Z")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  bonds           SubscriptionBond[]
}

model SubscriptionBond {
  id             String           @id @default(uuid())
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  bondId         String           // Client-generated UUID
  togetherSince  String           // YYYY-MM-DD
  categories     String           @default("years,months,days_all,custom")
  lastNotified   String?          // e.g. "2026-08-27:500_days"
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([subscriptionId, bondId])
  @@index([subscriptionId])
}

// Temporary relay for a client-encrypted photo shared via QR/link — see
// AGENTS.md Invariant 11. `ciphertext` is opaque to the server: the
// decryption key travels only in the share payload itself (QR/link),
// never here. Rows are TTL-swept by `startSharedImageCleanup()`
// (`SHARED_IMAGE_TTL_HOURS`, default 24h) — this table is not a
// permanent store, unlike every other model in this file.
model SharedImage {
  id         String   @id @default(uuid())
  ciphertext Bytes
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
