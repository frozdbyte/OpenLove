datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

model PushSubscription {
  id              String             @id @default(uuid())
  endpoint        String             @unique
  p256dh          String
  auth            String
  timezone        String             @default("UTC")
  togetherSince   String?            // Optional legacy field for backward compatibility
  lastNotified    String?            // Optional legacy field
  clientUpdatedAt String             @default("1970-01-01T00:00:00.000Z")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  bonds           SubscriptionBond[]
}

model SubscriptionBond {
  id             String           @id @default(uuid())
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  bondId         String           // Client-generated UUID
  togetherSince  String           // YYYY-MM-DD
  categories     String           @default("years,months,days_all,custom")
  lastNotified   String?          // e.g. "2026-08-27:500_days"
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([subscriptionId, bondId])
  @@index([subscriptionId])
}
