# SQLite Database Path
DATABASE_URL="file:./data/openlove.db"

# Server Port (default: 3000)
PORT=3000

# Optional: Pre-configured VAPID Web Push Keys
# If left empty, OpenLove automatically generates and saves keys to data/vapid.json
PUBLIC_VAPID_KEY=
PRIVATE_VAPID_KEY=
VAPID_SUBJECT="mailto:admin@openlove.local"
