# SQLite Database Path
DATABASE_URL="file:./data/openlove.db"

# Server Port (default: 3000)
PORT=3000

# Optional: Pre-configured VAPID Web Push Keys
# If left empty, OpenLove automatically generates and saves keys to data/vapid.json
PUBLIC_VAPID_KEY=
PRIVATE_VAPID_KEY=

# Optional: contact address embedded in push tokens (RFC 8292 "sub" claim).
# This is a CONTACT ADDRESS, not your app's URL, and it must be on a PUBLIC domain.
# Apple's push service rejects .local / .lan / localhost / bare IPs with
# `403 BadJwtToken` and silently delivers nothing to iOS devices.
# Leave it unset and OpenLove picks a safe public fallback automatically.
# VAPID_SUBJECT=mailto:you@yourdomain.com

# Feature toggles (all default to their stated value when unset; accepts
# true/false/1/0/on/off/yes/no). Read fresh on every request, so flipping
# one and restarting the container takes effect with no rebuild needed.

# Share-to-partner links can optionally include a photo, relayed through the
# server client-encrypted (the server only ever stores opaque ciphertext —
# see AGENTS.md Invariant 11). Set to false to disable the public upload
# endpoint entirely if you'd rather not have this app accept any file upload
# on your server.
# FEATURE_SHARE_IMAGES=true

# How long a relayed photo (above) stays available before the server deletes
# it, in hours. Unlimited loads within this window, not read-once.
# SHARED_IMAGE_TTL_HOURS=24
